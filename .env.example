# LLM Provider Configuration
# Supported: gemini, groq, ollama, mock
LLM_PROVIDER=gemini

# Google Gemini (Free Tier: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq (Free Tier: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (Free & Local: https://ollama.com/)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Offline Testing / Zero-API-Key Mode
# Set to true to run deterministic offline runs without any API key
MOCK_LLM=false

# Processing & Retrieval Hyperparameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
MIN_SIMILARITY_THRESHOLD=0.15
ARXIV_MAX_RESULTS=5

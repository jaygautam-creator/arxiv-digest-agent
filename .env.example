# LLM Provider Configuration
# Supported: auto, gemini, groq, ollama, mock
# "auto" uses Groq if GROQ_API_KEY is set, else Gemini, else Ollama (USE_OLLAMA=true), else mock.
LLM_PROVIDER=auto

# Google Gemini (Free Tier: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary model is overloaded (HTTP 503) or rate-limited
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Groq (Free Tier: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama (Free & Local: https://ollama.com/)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Offline Testing / Zero-API-Key Mode
# Set to true to run deterministic offline runs without any API key
MOCK_LLM=false

# Processing & Retrieval Hyperparameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
# TF-IDF mode: refuse when no chunk reaches this cosine score (chosen from evals/)
MIN_SIMILARITY_THRESHOLD=0.05

# Retrieval backend: auto (hybrid if the "embeddings" extra is installed), hybrid, or tfidf
RETRIEVAL_MODE=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Cross-encoder that reorders the top candidates; leave empty to disable
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Hybrid mode refuses a question when no chunk reaches this embedding similarity
DENSE_SIMILARITY_THRESHOLD=0.55
RERANK_CANDIDATES=20
ARXIV_MAX_RESULTS=5
